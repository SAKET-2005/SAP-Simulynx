{
  "name": "simulynx",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "@types/node": "^24.0.0",
    "tsx": "^4",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "deploy": "cds deploy",
    "start": "cds deploy && cds-serve",
    "watch": "cds deploy && cds watch",
    "build": "cds build --production && node -e \"fs.cpSync('app', 'gen/srv/app', { recursive: true })\"",
    "seed": "tsx ./srv/seed.ts",
    "test": "tsx --test test/*.test.ts",
    "test:ai": "tsx ./scripts/test-ai.ts"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "sqlite.db"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      }
    }
  }
}
