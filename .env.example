# SAP Simulynx - Environment Configuration Example
# Copy to .env for local overrides if connecting to SAP AI Core / Generative AI Hub

# Optional: SAP BTP AI Core Credentials (if available in sandbox)
# When omitted, Simulynx automatically uses its built-in deterministic provider.
# AICORE_BASE_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com
# AICORE_CLIENT_ID=your-sap-btp-ai-client-id
# AICORE_CLIENT_SECRET=your-sap-btp-ai-client-secret
# AICORE_AUTH_URL=https://your-tenant.authentication.eu10.hana.ondemand.com
# AICORE_RESOURCE_GROUP=default
# AICORE_DEPLOYMENT_ID=default
# Alternatively, if using a direct Joule / Generative AI Hub API key proxy:
# SAP_AI_API_KEY=your-api-key

# SAP BTP Cloud Foundry Environment
PORT=4004
NODE_ENV=development
